# VALLORYS Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
DEBUG=true
API_PREFIX=/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://vallorys:vallorys@localhost:5432/vallorys
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# External APIs
DVF_API_URL=https://api.dvf.etalab.gouv.fr
DVF_API_TIMEOUT=30

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Rate Limiting
RATE_LIMIT_VALUATION=50
RATE_LIMIT_FIELDPACK=30
RATE_LIMIT_OBJECTION=100

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# Multi-tenant
DEFAULT_TENANT_SCHEMA=tenant_default
